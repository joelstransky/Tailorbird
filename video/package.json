{
  "name": "tailorbird-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion launch video for Tailorbird",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render LaunchModern out/tailorbird-launch-modern.mp4",
    "build:modern": "remotion render LaunchModern out/tailorbird-launch-modern.mp4",
    "build:v2": "remotion render LaunchV2 out/tailorbird-launch-v2.mp4",
    "build:v1": "remotion render Launch out/tailorbird-launch.mp4",
    "still": "remotion still LaunchModern out/thumbnail-modern.png --frame=260",
    "audio": "node scripts/make-audio-modern.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
